PROGRAM PLC_PRG
VAR
	button AT %IX0.0 : BOOL; //привязка кнопки к физическому порту входа ПЛК (* т.к. ПЛК виртуальный). Нажал-не нажал.I-вход(Input)
	lamp AT %QX0.0 : BOOL; //привязка лампочки к физическому порту выхода ПЛК. TRUE-лампочка горит. Q-выход(output)
	buttonOld : BOOL; //для запоминания предыдущего состояния кнопки. Изначально FALSE
	numMode : INT; //номер текущего режима(будет хранить 0,1 или 2)
	timer_z : TON; //таймер с задержкой вкл. Будет отсчитывать 0.5сек для мигания
	timer_p : BOOL; (*флаг состояния мигания (хранит, горит лампа или нет в данный момент). Переключается каждые 0.5 сек таймером timer_z*)
END_VAR

//Область кода
//Переключение режимов

IF button AND NOT buttonOLD THEN (*если кнопка нажата(button = true) И при этом в прошлом цикле 
она была отпущена(buttonOld = FALSE). Это детекция переднего фронта - ловит момент нажатия.*)
    numMode := numMode + 1; //увеличиваем номер режима на 1
	//Использую вложенный цикл. Если режим стал больше 2(т.е 3), то сбрасываем его в 0. Цикл получается 0-1-2-0-1-2
	IF numMode > 2 THEN
		numMode := 0;
	END_IF
END_IF
buttonOld := button; //запоминаем тек.состояние кнопки для след.цикла. Теперь buttonOld равен тому, чьто было в button

//Управление лампой по режимам

CASE numMode OF //CASE - оператор выбора, который выполняет разные действия в зависимости от значения numMode.
	0:	//режим 0(выкл)
		lamp := FALSE; //лампочка выкл.
		timer_z(IN := FALSE); //IN - входной параметр. Останавливаем/сбрасываем таймер.
		timer_p := FALSE; //сбрасываем состояние мигания в FALSE. Чтобы при переходе в режим 2 начать с выкл.состояния.
	1:  //режим 1 (горит постоянно)
		lamp := TRUE; //лампочка вкл. (горит постоянно)
		timer_z(IN := FALSE); //таймер остановлен (не нужен в этот режиме)
	2: //режим 2(мигает)
		timer_z(IN := TRUE, PT := T#500MS); //запускаем таймер 0.5 сек.
		IF timer_z.Q THEN //Если таймер досчитает до 0.5сек. Q - обращение к выходу таймера
			timer_z(IN := FALSE); //Сбрасываем таймер, после этого Q = FALSE
			timer_p := NOT timer_p; //переключаем тек.состояние мигания на противоположное TRUE=>FALSE FALSE=>TRUE
		END_IF //конец проверки таймера
		lamp := timer_p; //// лампочка = текущее состояние мигания. Каждые 0.5 сек состояние переключается: вкл/выкл/вкл/выкл...
END_CASE //конец оператора выбора режимов 
